# ───────────────────────────────────────────────────────────
# Agency Tycoon — environment configuration
# Copy this file to `.env.local` and adjust as needed.
# ───────────────────────────────────────────────────────────

# Which AI backend powers the agents.
#   cli   → shells out to the locally-installed `claude` CLI (great for free testing)
#   api   → uses the Anthropic API with ANTHROPIC_API_KEY
#   mock  → no AI, returns templated demo output (works fully offline)
LLM_PROVIDER=cli

# Model to use (applies to both cli and api modes).
LLM_MODEL=claude-sonnet-4-6

# Required only when LLM_PROVIDER=api
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: path to the claude binary if it is not on PATH (cli mode).
# CLAUDE_CLI_PATH=claude
